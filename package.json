{
  "name": "@rainersoft/ui",
  "version": "2.2.0",
  "description": "Componentes UI reutilizáveis com Radix UI e Tailwind CSS",
  "packageManager": "pnpm@10.28.0",
  "author": {
    "name": "Rainer Teixeira",
    "email": "suporte@rainersoft.com.br"
  },
  "license": "MIT",
  "keywords": [
    "ui-components",
    "radix-ui",
    "tailwind",
    "design-system",
    "react-components"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/global.css": "./src/styles/global.css"
  },
  "files": [
    "dist",
    "src/styles",
    "cli",
    "components.json",
    "README.md"
  ],
  "bin": {
    "rainer-ui": "cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext ts,tsx",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist node_modules pnpm-lock.yaml .turbo",
    "validate": "node scripts/validate-no-hardcode.js",
    "type-check": "tsc --noEmit",
    "changelog": "tsx scripts/generate-changelog.ts",
    "release": "tsx scripts/release-package.ts",
    "release:dry-run": "tsx scripts/release-package.ts --dry-run",
    "release:validate": "tsx scripts/release-package.ts --validate-only",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next-themes": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rainersoft/design-tokens": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^12.24.0",
    "lucide-react": "0.460.0",
    "qrcode.react": "^4.2.0",
    "react-hook-form": "^7.70.0",
    "sonner": "^1.4.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/addon-interactions": "8.6.15",
    "@storybook/addon-links": "8.6.15",
    "@storybook/addon-viewport": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "glob": "^13.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "external": [
      "react",
      "react-dom"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}